{
	"tasks": {
		"prepare": "deno task 'prepare:*'",
		"prepare:htmx": "deno run -A npm:htmx-router",
		"prepare:prisma": "deno run -A npm:prisma generate",
		"check": "deno check '**/*' && deno run -A npm:typescript@^5.5.4/tsc",
		"lint": "deno lint",
		"start": "deno serve -A --parallel ./server.production.ts",
		"test": "deno test .",

		"prisma": "deno run -A npm:prisma",
		"prisma:generate": "deno task prisma generate --sql",
		"prisma:migrate:dev": "deno task prisma migrate dev",

		"build": "deno task 'build:*'",
		"build:client": "deno run -A npm:vite build",
		"build:server": "deno run -A npm:vite build --ssr app/entry.server.ts --outDir dist/server",

		"build:wasm": "deno task 'build:wasm:*'",
		"build:wasm:mf-factor": "wat2wasm ./wasm/mf-factor.wat -o ./wasm/mf-factor.wasm --debug-names",

		"compile": "deno compile -A production.ts --include build/* --include public/*",

		"preview": "deno serve -A --env-file server.production.ts",
		"dev": "deno serve -A --env-file server.dev.ts"
	},
	"exclude": [ "./build/" ],
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["deno.ns", "DOM", "DOM.Iterable", "ES2022", "webworker"],
		"strict": true,
		"strictNullChecks": true,
		"types": ["react", "react-dom", "@types/react", "./types.d.ts"]
	},
	"imports": {
		"@db/": "./dist/prisma/",
		"~/": "./app/",

		"@std/http": "jsr:@std/http@^1.0.4",
		"@std/io":   "jsr:@std/io",
		"@std/path": "jsr:@std/path@^1.0.3",

		"@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.4",
		"@fortawesome/free-brands-svg-icons": "npm:@fortawesome/free-brands-svg-icons@^6.6.0",
		"@fortawesome/free-solid-svg-icons": "npm:@fortawesome/free-solid-svg-icons@^6.5.2",
		"@fortawesome/react-fontawesome": "npm:@fortawesome/react-fontawesome@^0.2.2",
		"@huggingface/transformers": "npm:@huggingface/transformers@^3.7.1",
		"@prisma/adapter-pg": "npm:@prisma/adapter-pg@~6.18.0",
		"@prisma/client": "npm:@prisma/client@~6.18.0",
		"chalk": "npm:chalk@~5.3.0",
		"chart.js": "npm:@chart.js^4.4.9",
		"chartjs-adapter-date-fns": "npm:@chartjs-adapter-date-fns^3.0.0",
		"chartjs-plugin-trendline": "npm:@chartjs-plugin-trendline@^2.1.9",
		"dotenv": "npm:dotenv@~17.2.2",
		"extract-colors": "npm:extract-colors@^4.2.0",
		"htmx-router": "npm:htmx-router@~2.1.6",
		"hx-stream": "npm:hx-stream@~0.2.2",
		"jimp": "npm:jimp@^1.6.0",
		"pg": "npm:pg@~8.16.3",
		"prisma-json-types-generator": "npm:prisma-json-types-generator@~3.6.2",
		"react": "npm:react@~18.3.1",
		"react-dom": "npm:react-dom@~18.3.1",
		"tiny-invariant": "npm:tiny-invariant@~1.3.3",
		"typed-htmx": "npm:typed-htmx@~0.3.1",
		"typescript": "npm:typescript@^5.5.4",
		"vite": "npm:vite@^6.3.2",
		"vite-tsconfig-paths": "npm:vite-tsconfig-paths@^5.1.3",

		"@types/express": "npm:@types/express@^4.17.21",
		"@types/react": "npm:@types/react@~18.3.1",
		"@types/react-dom": "npm:@types/react-dom@~18.3.1"
	},
	"lint": {
		"include": ["app/"],
		"rules": {
			"tags": ["recommended"],
			"include": ["ban-untagged-todo"],
			"exclude": ["no-unused-vars"]
		}
	},
	"ignore-fmt": {
		"useTabs": true,
		"semiColons": true,
		"proseWrap": "preserve",
		"include": ["app/"],
		"exclude": []
	},
	"lock": false,
	"test": {
		"include": ["tests/**"]
	}
}
